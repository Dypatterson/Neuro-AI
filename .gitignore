.venv
.venv/
__pycache__/
*.py[cod]
.DS_Store
.codex_deps/
tmp/
research/
# Brainstorm workspaces curate their own /research/ subdirs as committable
# artefacts (deep-research briefs that pair with the brainstorm doc).
# The project-wide research/ rule above ignored these silently; this
# exception keeps them committable. Codex audit 2026-05-23 caught the drop.
!brainstorm-workspace/**/research/
!brainstorm-workspace/**/research/**
*.pt
.claude/
.env
.env.*


# reports/ = generated experiment output. Keep only narrative NNN_*.md notes.
reports/**/*.json
reports/**/*.csv
reports/**/*.log
reports/**/*.err
reports/**/*.out
# Sharded-merge intermediates from the Colab/parallel runners (the merged
# result is itself *.json above; the narrative lives in report.md).
reports/**/shards/

# experiments/ run logs are transient stdout (regenerable). Track the exp*.json
# result data (committed alongside its report), not the logs. (2026-06-29)
experiments/*.log

# Workflow raw scratch dumps — the curated brief is the committed artefact.
brainstorm-workspace/**/_*_raw.json

# SCAN benchmark data — public + re-downloadable via scripts/fetch_scan.sh.
# Track the fetch script, not the ~8MB of .txt (Bet-B discriminating regime, 2026-06-15).
data/scan/
