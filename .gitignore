.venv
.venv/
__pycache__/
*.py[cod]
.DS_Store
.codex_deps/
tmp/
research/
# Brainstorm workspaces curate their own /research/ subdirs as committable
# artefacts (deep-research briefs that pair with the brainstorm doc).
# The project-wide research/ rule above ignored these silently; this
# exception keeps them committable. Codex audit 2026-05-23 caught the drop.
!brainstorm-workspace/**/research/
!brainstorm-workspace/**/research/**
*.pt
.claude/
.env
.env.*

