.venv
.venv/
__pycache__/
*.py[cod]
.DS_Store
.codex_deps/
tmp/
research/
# Brainstorm workspaces curate their own /research/ subdirs as committable
# artefacts (deep-research briefs that pair with the brainstorm doc).
# The project-wide research/ rule above ignored these silently; this
# exception keeps them committable. Codex audit 2026-05-23 caught the drop.
!brainstorm-workspace/**/research/
!brainstorm-workspace/**/research/**
*.pt
.claude/
.env
.env.*


# reports/ = generated experiment output. Keep only narrative NNN_*.md notes.
reports/**/*.json
reports/**/*.csv
reports/**/*.log
reports/**/*.err
reports/**/*.out
# Sharded-merge intermediates from the Colab/parallel runners (the narrative
# lives in report.md).
reports/**/shards/

# ...BUT the merged headline result IS the evidence and must be committable.
# Before 2026-07-25 the blanket *.json rule above meant `find reports -type f
# ! -name '*.md'` returned 14 files (all PNG/stderr) across 196 reports: not one
# number behind any published claim was on disk, so no result could be
# re-checked. Merged headline artifacts are now tracked; shards stay ignored.
!reports/**/headline*.json
!reports/**/*_headline.json

# Workflow raw scratch dumps — the curated brief is the committed artefact.
brainstorm-workspace/**/_*_raw.json
