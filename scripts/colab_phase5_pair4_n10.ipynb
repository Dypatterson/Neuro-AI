<cell id="cell-7"># 5. Launch 20 parallel workers — 10 seeds × 2 conditions.
#
# Each worker is its own subprocess. The κ=0 control and κ>0 active condition
# for the same seed get IDENTICAL CLI args except --metastability-gain. The
# substrate's RNG is seeded by --seed, so both conditions start from the same
# initial state. (The substrate's stochastic operations during training will
# diverge after the first replay-priority computation differs — that
# divergence is exactly the effect of κ we want to measure.)

SEEDS = [17, 11, 23, 1, 2, 3, 5, 7, 13, 29]
N_CUES = 3000  # Phase 4 graduation regime
RUN_TAG = 'phase5_pair4_n10'

# Pre-committed parameters (locked in this notebook — DO NOT tune after launch).
OBS_RATE = 0.05
REP_DECAY = 0.5
KAPPA_ACTIVE = 2.0
# A+B (Phase 5 substrate prerequisites — same as the pair #4 baseline substrate).
ALPHA_ANTI = 1.0
COVERAGE_LAMBDA = 1.0
COVERAGE_EMA_RATE = 0.01
REPULSION_STEP_SIZE = 100.0

import subprocess, os, time
from pathlib import Path

os.environ['PYTHONPATH'] = '/content/Neuro-AI/src'
log_root = Path(f'reports/{RUN_TAG}_colab')
log_root.mkdir(parents=True, exist_ok=True)

CONDITIONS = [
    ('kappa0_control', 0.0),
    ('pair4_active',   KAPPA_ACTIVE),
]

def launch(seed, condition_tag, kappa):
    out_dir = f'reports/{RUN_TAG}_{condition_tag}_seed{seed}'
    Path(out_dir).mkdir(parents=True, exist_ok=True)
    log_path = log_root / f'{condition_tag}_seed{seed}.log'
    logf = open(log_path, 'w')
    cmd = [
        'python', 'experiments/19_phase34_integrated.py',
        '--device', 'cuda',
        '--updater-kind', 'hebbian',
        '--seed', str(seed),
        '--n-cues', str(N_CUES),
        '--store-threshold', '0.3',
        # A+B substrate prerequisites (the substrate this mechanism builds on).
        '--alpha-anti', str(ALPHA_ANTI),
        '--coverage-lambda', str(COVERAGE_LAMBDA),
        '--coverage-ema-rate', str(COVERAGE_EMA_RATE),
        '--repulsion-step-size', str(REPULSION_STEP_SIZE),
        # Pair #4 knobs.
        '--metastability-obs-rate', str(OBS_RATE),
        '--metastability-gain', str(kappa),
        '--metastability-replay-decay', str(REP_DECAY),
        '--output-dir', out_dir,
    ]
    print(f'launching {condition_tag} seed={seed} (κ={kappa}) -> {out_dir}')
    proc = subprocess.Popen(cmd, stdout=logf, stderr=subprocess.STDOUT, env=os.environ.copy())
    return proc, logf, log_path

# Launch all 20 workers in parallel. ~1.6 GB VRAM each → 32/95 GB total on H100.
procs = []
for seed in SEEDS:
    for tag, kappa in CONDITIONS:
        procs.append(launch(seed, tag, kappa))

# Wait, polling.
t0 = time.time()
remaining = list(range(len(procs)))
while remaining:
    still_alive = []
    for i in remaining:
        proc, logf, log_path = procs[i]
        rc = proc.poll()
        if rc is None:
            still_alive.append(i)
        else:
            logf.close()
            mins = (time.time() - t0) / 60
            print(f'worker {i} done (rc={rc}) at {mins:.1f} min   log={log_path}')
    remaining = still_alive
    if remaining:
        time.sleep(30)
print(f'ALL DONE in {(time.time()-t0)/60:.1f} min')</cell id="cell-7">
