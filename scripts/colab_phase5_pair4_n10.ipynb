<cell id="cell-9"># 6. Aggregate the headline: Δ meta_stable_rate at W=3 across same-seed pairs.
import json
import numpy as np
from pathlib import Path

SEEDS = [17, 11, 23, 1, 2, 3, 5, 7, 13, 29]
RUN_TAG = 'phase5_pair4_n10'

def load_run(condition_tag, seed):
    p = Path(f'reports/{RUN_TAG}_{condition_tag}_seed{seed}/phase34_results.json')
    if not p.exists():
        return None
    return json.loads(p.read_text())

def w3_meta_stable_rate_at_last_eval(run):
    """Extract meta_stable_rate at W=3 from the phase3_phase4 condition's last eval."""
    if run is None:
        return None
    for entry in run.get('results', []):
        if entry.get('condition') != 'phase3_phase4':
            continue
    # Per the existing report format, eval rows are keyed by condition+scale+cues_seen.
    # The structure varies slightly across versions — try the most common layouts.
    rows = [
        r for r in run.get('results', [])
        if r.get('condition') == 'phase3_phase4' and r.get('scale') == 3
    ]
    if not rows:
        return None
    last = max(rows, key=lambda r: r.get('cues_seen', 0))
    return last.get('meta_stable_rate')

pairs = []
for s in SEEDS:
    ctl = load_run('kappa0_control', s)
    act = load_run('pair4_active', s)
    r_ctl = w3_meta_stable_rate_at_last_eval(ctl)
    r_act = w3_meta_stable_rate_at_last_eval(act)
    if r_ctl is None or r_act is None:
        print(f'seed {s}: MISSING (ctl={r_ctl}, act={r_act})')
        continue
    delta = r_act - r_ctl
    pairs.append((s, r_ctl, r_act, delta))
    print(f'seed {s}: kappa0={r_ctl:.4f}  pair4={r_act:.4f}  Δ={delta:+.4f}')

deltas = np.array([p[3] for p in pairs])
print(f'\n=== Headline: Δ meta_stable_rate at W=3, n={len(deltas)} same-seed pairs ===')
print(f'  mean Δ = {deltas.mean():+.4f}')
print(f'  std  Δ = {deltas.std(ddof=1):.4f}')

# Bootstrap 95% CI on mean Δ.
rng = np.random.default_rng(2026)
boots = [rng.choice(deltas, size=len(deltas), replace=True).mean() for _ in range(10_000)]
ci_lo, ci_hi = np.quantile(boots, [0.025, 0.975])
print(f'  bootstrap 95% CI: [{ci_lo:+.4f}, {ci_hi:+.4f}]')

# Pre-committed pass criteria.
PASS_THRESHOLD = -0.10
ci_disjoint_neg = ci_hi < 0.0
hits_threshold = deltas.mean() <= PASS_THRESHOLD
print()
print(f'PASS criteria:')
print(f'  bootstrap CI disjoint from zero (upper < 0): {"PASS" if ci_disjoint_neg else "FAIL"}')
print(f'  mean Δ ≤ {PASS_THRESHOLD:.2f}:                       {"PASS" if hits_threshold else "FAIL"}')
print(f'  overall:                                       {"PASS" if (ci_disjoint_neg and hits_threshold) else "FAIL"}')</cell id="cell-9">
<cell id="cell-10"># 7. Drill-downs: m_i distribution sanity + D1 non-regression + d_eff non-regression.
import numpy as np

def w3_last(run, key):
    rows = [r for r in run.get('results', []) if r.get('condition') == 'phase3_phase4' and r.get('scale') == 3]
    if not rows:
        return None
    last = max(rows, key=lambda r: r.get('cues_seen', 0))
    return last.get(key)

print('=== Drill-down: m_i distribution (audit-binding sanity check) ===')
print('  At first eval (~step 500), std/mean of metastability_ema should be > 0.1 for pair4_active.')
print('  Otherwise the mechanism is not differentiating between atoms.\n')
for s in SEEDS:
    act = load_run('pair4_active', s)
    if not act:
        continue
    # First eval row (smallest cues_seen) for W=3 phase3_phase4.
    rows = [r for r in act.get('results', []) if r.get('condition') == 'phase3_phase4' and r.get('scale') == 3]
    if not rows:
        continue
    first = min(rows, key=lambda r: r.get('cues_seen', 0))
    dd = first.get('death_diag', {})
    m_mean = dd.get('metastability_ema_mean', 0.0) or 0.0
    m_std = dd.get('metastability_ema_std', 0.0) or 0.0
    cv = (m_std / m_mean) if m_mean > 1e-6 else 0.0
    print(f'  seed {s}: m_mean={m_mean:.4f}  m_std={m_std:.4f}  CV={cv:.2f}  '
          f'({"PASS" if cv > 0.1 else "FAIL (uniform)"})')

print('\n=== Drill-down: d_eff non-regression (≥ 25 at step 1800) ===')
for s in SEEDS:
    act = load_run('pair4_active', s)
    if not act:
        continue
    rows = [r for r in act.get('results', []) if r.get('condition') == 'phase3_phase4' and r.get('scale') == 4]
    if not rows:
        continue
    last = max(rows, key=lambda r: r.get('cues_seen', 0))
    dd = last.get('death_diag', {})
    # d_eff may be reported under different keys; check both common spellings.
    d_eff = dd.get('d_eff') or dd.get('substrate_d_eff') or last.get('d_eff')
    print(f'  seed {s}: W=4 final d_eff = {d_eff} ({"PASS" if (d_eff and d_eff >= 25) else "CHECK"})')</cell id="cell-10">
